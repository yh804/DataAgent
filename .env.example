# ===== LLM 连接:两种模式,优先级「请求头 > .env」=====
# 模式一 BYOK(使用者自带,推荐公网 / 多人使用):
#   浏览器「⚙️ 模型设置」里填 Key / Base URL / Model,只存 localStorage,
#   随请求头 X-LLM-Key / X-LLM-Base / X-LLM-Model 发送,服务端不落盘、不写日志。
#   此时下面的 LLM_API_KEY 可以留空;Base URL / Model 也可由请求头覆盖。
# 模式二 自托管(服务端 .env,本机 / 内网单用户):
#   在 .env 填入下面的配置,作为请求头缺省时的默认值。
LLM_BASE_URL=https://api.deepseek.com
# 接口密钥(占位符,请替换为真实 Key;.env 禁止提交到版本控制)
# BYOK 模式下可留空,由浏览器设置提供
LLM_API_KEY=sk-your-key-here
# 模型名称;结构化输出用 function_calling,DeepSeek 请选 deepseek-chat
LLM_MODEL=deepseek-chat

# ===== LLM(可选)=====
# 单次请求超时秒数,默认 60
# LLM_TIMEOUT=60
# 失败重试次数,默认 1
# LLM_MAX_RETRIES=1

# ===== 沙箱(可选)=====
# 沙箱后端:docker(默认) / e2b
# SANDBOX_BACKEND=docker
# 沙箱数据目录,默认 data/processed(analyze.py / ask_db.py 会在运行期覆盖)
# SANDBOX_DATA_DIR=data/processed
# E2B 后端必填:E2B_API_KEY=

# ===== 检查点(可选)=====
# 检查点后端:sqlite(默认,跨进程持久化) / memory(进程内,退出即丢)
# CHECKPOINT_BACKEND=sqlite
# SQLite 文件路径,默认 outputs/checkpoints.sqlite
# CHECKPOINT_PATH=outputs/checkpoints.sqlite

# ===== 汇总节点(可选)=====
# 是否调用 LLM 生成结论汇总,默认 true;设为 false 时走模板降级,
# summarize 节点与 outputs/runs/ 归档仍然保留
# SUMMARY_ENABLED=true

# ===== 可观测(可选)=====
# 是否写 outputs/traces/*.json,默认 true;设为 false 关闭
# TRACE_ENABLED=true

# ===== 数据库查询缓存 =====
# 只读查询结果缓存开关;设为 0 时读写均关闭,每次都真查数据库
DB_CACHE=1
# 缓存有效期(秒),默认 600(10 分钟);超时后下次查询会重新执行
DB_CACHE_TTL_SECONDS=600
# MySQL 单条 SQL 执行超时(毫秒),默认 30000,允许 1000~300000;
# socket 读超时会自动比它多 5 秒
MYSQL_QUERY_TIMEOUT_MS=30000
# 数据库查询超时(秒),默认 120,允许 1~600;超时后页面显示「超过 N 秒」并取消查询
DB_QUERY_TIMEOUT_SECONDS=120
# 执行前体检判定 block 并自动重写后,那次查询的超时(秒),默认 120,允许 1~600;
# 仅用于重写后的执行,不影响常规查询超时
DB_GUARD_TIMEOUT_SECONDS=120

# ===== 领域包(可选)=====
# 启用领域包后,planner / code_analyst / summarize 会把领域上下文与指标口径
# 注入到 prompt;未设置或设为空则保持现有行为不变。
# 取值必须是 domains/<name>/ 下真实目录名,如 ecommerce;非法值自动关闭。
# DOMAIN_PACK=ecommerce
